{
  "id": "WF_PRODUCTION_PIPELINE",
  "name": "Production Pipeline Bootstrap",
  "version": "v001",
  "description": "Initializes the operational task graph for a new AI Film Studio project, creates dependency-aware production tasks, then audits and manifests the project.",
  "risk_level": "LOW",
  "approval_required": false,
  "steps": [
    {
      "name": "create_project_brief_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Complete Project Brief",
        "--department",
        "Producer",
        "--priority",
        "P1",
        "--phase",
        "INTAKE",
        "--description",
        "Define the project's purpose, audience, scope, runtime, creative direction, technical requirements, research requirements, rights considerations, and success criteria."
      ]
    },
    {
      "name": "create_research_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Establish Initial Research",
        "--department",
        "Research",
        "--priority",
        "P1",
        "--phase",
        "INTAKE",
        "--depends-on",
        "TASK_001",
        "--description",
        "Identify the research questions, required evidence, primary and secondary sources, factual uncertainties, and visual research requirements."
      ]
    },
    {
      "name": "create_creative_direction_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Define Creative Direction",
        "--department",
        "Director",
        "--priority",
        "P1",
        "--phase",
        "INTAKE",
        "--depends-on",
        "TASK_001",
        "--description",
        "Establish the project's creative intent, audience experience, tone, visual identity, cinematic language, emotional architecture, and major creative constraints."
      ]
    },
    {
      "name": "create_story_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Develop Story Structure",
        "--department",
        "Writer",
        "--priority",
        "P1",
        "--phase",
        "STORY",
        "--depends-on",
        "TASK_002",
        "--description",
        "Develop the core story, structure, treatment, narration or screenplay requirements, and connect the story to verified research where applicable."
      ]
    },
    {
      "name": "create_script_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Develop Script",
        "--department",
        "Writer",
        "--priority",
        "P1",
        "--phase",
        "SCRIPT",
        "--depends-on",
        "TASK_002,TASK_004",
        "--description",
        "Develop the production script, narration, dialogue, scene structure, timing, and visual writing."
      ]
    },
    {
      "name": "create_director_treatment_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Create Director Treatment",
        "--department",
        "Director",
        "--priority",
        "P1",
        "--phase",
        "DIRECTOR DEVELOPMENT",
        "--depends-on",
        "TASK_003,TASK_005",
        "--description",
        "Translate the approved story and script direction into visual storytelling, scene objectives, performance direction, camera language, pacing, and cinematic treatment."
      ]
    },
    {
      "name": "create_production_design_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Develop Production Design",
        "--department",
        "Production Design",
        "--priority",
        "P1",
        "--phase",
        "PRODUCTION DESIGN",
        "--depends-on",
        "TASK_006",
        "--description",
        "Develop locations, sets, environments, props, materials, architecture, visual world rules, and production design references."
      ]
    },
    {
      "name": "create_storyboard_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Create Storyboard and Previs Plan",
        "--department",
        "Storyboard / Previs",
        "--priority",
        "P1",
        "--phase",
        "STORYBOARD / PREVIS",
        "--depends-on",
        "TASK_006,TASK_007",
        "--description",
        "Break scenes into purposeful shots, establish coverage, blocking, screen direction, camera movement, timing, and previs requirements."
      ]
    },
    {
      "name": "create_cinematography_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Create Cinematography Plan",
        "--department",
        "Cinematography",
        "--priority",
        "P1",
        "--phase",
        "CINEMATOGRAPHY",
        "--depends-on",
        "TASK_008",
        "--description",
        "Define framing, camera placement, lens strategy, movement, composition, lighting, depth, color direction, and shot-level visual requirements."
      ]
    },
    {
      "name": "create_ai_generation_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Prepare AI Generation Pipeline",
        "--department",
        "AI Generation",
        "--priority",
        "P1",
        "--phase",
        "AI GENERATION",
        "--depends-on",
        "TASK_008,TASK_009",
        "--description",
        "Prepare character references, environment references, prompts, models, generation workflows, continuity constraints, and AI production tests."
      ]
    },
    {
      "name": "create_production_readiness_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Production Readiness Review",
        "--department",
        "Production Management",
        "--priority",
        "P1",
        "--phase",
        "PRODUCTION",
        "--depends-on",
        "TASK_007,TASK_008,TASK_009,TASK_010",
        "--description",
        "Verify that story, design, shot planning, cinematography, AI preparation, assets, resources, dependencies, and technical requirements are ready for production."
      ]
    },
    {
      "name": "create_edit_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Create Editorial Assembly",
        "--department",
        "Edit",
        "--priority",
        "P1",
        "--phase",
        "EDIT",
        "--depends-on",
        "TASK_011",
        "--description",
        "Assemble produced material into an editorial timeline and establish the initial structural cut."
      ]
    },
    {
      "name": "create_vfx_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Complete VFX and Motion",
        "--department",
        "VFX / Motion",
        "--priority",
        "P1",
        "--phase",
        "VFX / MOTION",
        "--depends-on",
        "TASK_012",
        "--description",
        "Complete required VFX, compositing, cleanup, motion graphics, titles, maps, infographics, and visual integration."
      ]
    },
    {
      "name": "create_sound_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Complete Sound Design",
        "--department",
        "Sound",
        "--priority",
        "P1",
        "--phase",
        "SOUND",
        "--depends-on",
        "TASK_012",
        "--description",
        "Complete dialogue, voice-over, ambience, Foley, SFX, sound design, mixing, and audio QC preparation."
      ]
    },
    {
      "name": "create_music_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Complete Music and Score",
        "--department",
        "Music",
        "--priority",
        "P1",
        "--phase",
        "MUSIC",
        "--depends-on",
        "TASK_012",
        "--description",
        "Create, edit, or source the required score and music cues while maintaining musical identity, timing, stems, and rights records."
      ]
    },
    {
      "name": "create_color_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Complete Color and Image Finish",
        "--department",
        "Color",
        "--priority",
        "P1",
        "--phase",
        "COLOR",
        "--depends-on",
        "TASK_013,TASK_014,TASK_015",
        "--description",
        "Complete technical color normalization, look development, scene matching, VFX integration, grain or texture treatment, and final image finishing."
      ]
    },
    {
      "name": "create_continuity_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Continuity Review",
        "--department",
        "Continuity",
        "--priority",
        "P1",
        "--phase",
        "CONTINUITY",
        "--depends-on",
        "TASK_012,TASK_013,TASK_014,TASK_015,TASK_016",
        "--description",
        "Review character, prop, location, geography, timing, performance, camera, VFX, sound, music, color, and AI continuity."
      ]
    },
    {
      "name": "create_technical_post_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Technical Post Validation",
        "--department",
        "Technical Post",
        "--priority",
        "P1",
        "--phase",
        "TECHNICAL POST",
        "--depends-on",
        "TASK_016,TASK_017,TASK_018,TASK_019,TASK_020",
        "--description",
        "Validate codecs, resolution, frame rate, color management, audio specifications, file integrity, project references, and final technical readiness."
      ]
    },
    {
      "name": "create_qc_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Final Quality Control",
        "--department",
        "QC",
        "--priority",
        "P0",
        "--phase",
        "QC",
        "--depends-on",
        "TASK_020,TASK_021",
        "--description",
        "Perform creative, technical, factual where applicable, continuity, audio, color, VFX, AI, subtitle, accessibility, and delivery QC."
      ]
    },
    {
      "name": "create_legal_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Final Rights Review",
        "--department",
        "Legal / Rights",
        "--priority",
        "P0",
        "--phase",
        "LEGAL / RIGHTS",
        "--depends-on",
        "TASK_022",
        "--description",
        "Verify required rights, licenses, releases, permissions, music clearance, archival material, AI usage terms, and third-party content status."
      ]
    },
    {
      "name": "create_delivery_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Prepare Final Delivery",
        "--department",
        "Distribution",
        "--priority",
        "P0",
        "--phase",
        "DELIVERY",
        "--depends-on",
        "TASK_022,TASK_023",
        "--description",
        "Create approved platform-specific deliverables, validate specifications, metadata, subtitles, captions, credits, and delivery packaging."
      ]
    },
    {
      "name": "create_archive_task",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "task-add",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}",
        "--name",
        "Archive Completed Project",
        "--department",
        "Knowledge / Archive",
        "--priority",
        "P1",
        "--phase",
        "ARCHIVE",
        "--depends-on",
        "TASK_024",
        "--description",
        "Preserve final masters, project files, source manifests, prompts, AI generation logs, research, rights, QC, technical information, delivery records, and production knowledge."
      ]
    },
    {
      "name": "run_project_audit",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "audit",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}"
      ]
    },
    {
      "name": "generate_manifest",
      "type": "command",
      "args": [
        "python",
        "{{REPO_ROOT}}/scripts/create_project.py",
        "manifest",
        "{{PROJECT_ID}}",
        "{{PROJECT_SLUG}}"
      ]
    }
  ]
}
