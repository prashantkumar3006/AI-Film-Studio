# Copy to .env (git-ignored) and fill in. Never commit real values.

# GridShare instance (from the instance page on gridshare.in)
GRIDSHARE_SSH_HOST=
GRIDSHARE_SSH_PORT=22
GRIDSHARE_SSH_USER=root
GRIDSHARE_SSH_KEY=~/.ssh/id_ed25519
GRIDSHARE_REMOTE_DIR=/workspace/studio
GRIDSHARE_GPU=rtx_4090
# Optional: GridShare REST API key (for future instance start/stop automation)
GRIDSHARE_API_KEY=

# Optional: legacy generic generator command for scripts/adapters/ai_generate.py
STUDIO_AI_GENERATOR_COMMAND=
